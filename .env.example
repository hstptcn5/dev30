DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
PORT=3000

# Preferred multi-user connection: GitHub App user OAuth.
# Register a GitHub App with callback URL http://localhost:3000/auth/github/callback for local development.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Required for sessions to survive Node restarts. Use a long random secret and never commit it.
DEV30_SESSION_SECRET=
# DEV30_SESSION_FILE=data/sessions.json

# Legacy local-development fallback. Not required when GitHub App OAuth is configured.
GITHUB_TOKEN=

# In-memory report cache. Cached analysis disappears when the Node process restarts.
CACHE_TTL_MINUTES=360

# Persistent local snapshot history. The default file is data/history.json and data/ is gitignored.
# DEV30_HISTORY_FILE=
HISTORY_MAX_PER_SERIES=24
HISTORY_MAX_TOTAL=500

# Persistent stakeholder/client reports. The default file is data/client-reports.json and data/ is gitignored.
# DEV30_CLIENT_REPORT_FILE=
CLIENT_REPORT_MAX_TOTAL=200

# Authenticated collection defaults. Public-lite mode automatically uses tighter limits.
MAX_DISCOVERED_REPOS=15
MAX_DEEP_DIVE_REPOS=5
MAX_COMMIT_PAGES=5
MAX_PR_PAGES=2
MAX_DETAIL_COMMITS_PER_REPO=3
MAX_DETAIL_PRS_PER_REPO=6
