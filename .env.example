DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
PORT=3000

# Public origin of the running app. Optional on localhost; required in production.
# Production example: https://dev30.example.com
APP_BASE_URL=
NODE_ENV=development
TRUST_PROXY=false
# COOKIE_SECURE=true

# Preferred multi-user connection: GitHub App user OAuth.
# Local callback: http://localhost:3000/auth/github/callback
# In production GITHUB_OAUTH_CALLBACK_URL may be omitted when APP_BASE_URL is set.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Required for sessions/workspace connections to survive Node restarts and required in production.
# Use a long random secret and never commit it.
DEV30_SESSION_SECRET=
# DEV30_SESSION_FILE=data/sessions.json

# Legacy local-development fallback. Not required when GitHub App OAuth is configured.
# Keep PAT fallback out of production when possible.
GITHUB_TOKEN=

# Persistence backend.
# local    -> existing data/*.json files, ideal for development/single-instance use.
# supabase -> shared SaaS persistence for sessions, snapshots, reports, schedules, usage and billing.
DEV30_STORAGE_BACKEND=local
SUPABASE_URL=
# Recommended current server key format: sb_secret_...
SUPABASE_SECRET_KEY=
# Legacy compatibility only:
# SUPABASE_SERVICE_ROLE_KEY=

# Explicit escape hatch for a single-instance production pilot only.
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
ALLOW_INSECURE_HTTP=false

# In-memory report cache. Cached analysis disappears when the Node process restarts.
CACHE_TTL_MINUTES=360

# Local persistence settings. Used only when DEV30_STORAGE_BACKEND=local.
# DEV30_HISTORY_FILE=data/history.json
# DEV30_CLIENT_REPORT_FILE=data/client-reports.json
# DEV30_SAAS_FILE=data/saas.json
HISTORY_MAX_PER_SERIES=24
HISTORY_MAX_TOTAL=500
CLIENT_REPORT_MAX_TOTAL=200

# Hourly cron caller. Keep this secret server-side and use it as Bearer auth for /api/internal/run-due.
DEV30_CRON_SECRET=
DEV30_CRON_BATCH=10
DEV30_CRON_LEASE_SECONDS=900

# Optional weekly email delivery through Resend.
RESEND_API_KEY=
DEV30_EMAIL_FROM=
DEV30_EMAIL_REPLY_TO=

# Optional Stripe Billing. Public analyzer remains available without billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Development/pilot override only: free or pro.
# DEV30_FORCE_PLAN=

# Authenticated collection defaults. Public-lite mode automatically uses tighter limits.
MAX_DISCOVERED_REPOS=15
MAX_DEEP_DIVE_REPOS=5
MAX_COMMIT_PAGES=5
MAX_PR_PAGES=2
MAX_DETAIL_COMMITS_PER_REPO=3
MAX_DETAIL_PRS_PER_REPO=6
